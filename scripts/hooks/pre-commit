#!/usr/bin/env bash

set -u

if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
cd "$repo_root" || exit 1

pytest_path=".venv/bin/pytest"
if [[ ! -x "$pytest_path" ]]; then
    echo "pre-commit: .venv/bin/pytest not found or not executable"
    exit 1
fi

if ! "$pytest_path" -q; then
    echo "pre-commit: tests failed, commit blocked"
    exit 1
fi

exit 0
